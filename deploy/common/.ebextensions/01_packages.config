# Native packages needed by every role: the web app renders PDF previews
# synchronously and the workers render them for emails, so both need
# Pango/Cairo; both need GDAL for PostGIS. The broker is ElastiCache
# (CELERY_BROKER_URL), so no Redis is installed on the instances.
#
# Python dependencies come from the requirements.txt that CI exports from
# poetry.lock; the EB platform installs it into its own venv, so Poetry itself
# is not installed on the instances.
packages:
  yum:
    git: []
    libpq-devel: []
    gcc: []
    mariadb105-devel.x86_64: []
    python3-devel: []
    mesa-libGL: []
    gcc-c++: []
    gdal310: []
    gdal310-libs: []
    poppler-utils: []
    poppler-data: []
    pango: []
    pango-devel: []
    cairo: []
    cairo-devel: []
    gdk-pixbuf2: []
    libffi-devel: []
