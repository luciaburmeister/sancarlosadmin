# Native packages and Poetry, needed by every role: the web app renders PDF
# previews synchronously and the workers render them for emails, so both
# need Pango/Cairo; both need GDAL for PostGIS. The broker is ElastiCache
# (CELERY_BROKER_URL), so no Redis is installed on the instances.
packages:
  yum:
    git: []
    libpq-devel: []
    gcc: []
    mariadb105-devel.x86_64: []
    python3-devel: []
    mesa-libGL: []
    gcc-c++: []
    gdal310: []
    gdal310-libs: []
    poppler-utils: []
    poppler-data: []
    pango: []
    pango-devel: []
    cairo: []
    cairo-devel: []
    gdk-pixbuf2: []
    libffi-devel: []

commands:
  01_install_poetry:
    command: |
      curl -sSL https://install.python-poetry.org | python3.14 -
      echo 'export PATH=$HOME/.local/bin:$PATH' >> /etc/profile.d/poetry.sh
      chmod +x /etc/profile.d/poetry.sh

  02_verify_poetry:
    command: |
      source /etc/profile.d/poetry.sh
      poetry --version
