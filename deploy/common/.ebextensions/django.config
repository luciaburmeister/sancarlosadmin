# collectstatic runs on every role. Production uses ManifestStaticFilesStorage,
# and the PDF service resolves logos and CSS through staticfiles_storage, so a
# worker without the manifest fails every render. Migrations are web-only
# (deploy/web/.ebextensions/web.config) so they run exactly once per release.
container_commands:
  01_collectstatic:
    command: |
      source /var/app/venv/staging-LQM1lest/bin/activate
      python manage.py collectstatic --noinput --ignore "*node_modules*"
    leader_only: true
