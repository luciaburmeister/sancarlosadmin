option_settings:
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static
  # Django's psycopg pool (settings.DB_POOL_MAX_SIZE), a hard cap per gunicorn
  # process: when all are busy a request waits (up to 10s) instead of opening
  # another connection. Sized so the app stays under RDS max_connections=79
  # (~74 usable): 1 instance x 4 workers x 12 = 48, plus ~10 for the worker
  # environment, leaves ~16 for migrations, shells and deploys. Re-derive it
  # if --workers in the Procfile, the instance count or the DB class change.
  aws:elasticbeanstalk:application:environment:
    DB_POOL_MAX_SIZE: "12"

# Migrations run here and nowhere else. The CI job deploys the web
# environment before the worker environment, so the schema is in place
# before new worker code starts.
container_commands:
  02_run_migrations:
    command: |
      source /var/app/venv/staging-LQM1lest/bin/activate
      python manage.py migrate
    leader_only: true
